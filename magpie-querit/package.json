{
  "name": "magpie-querit",
  "version": "1.0.0",
  "description": "Querit web search for magpie: adds a Querit API to Settings › Models › Web search, beside Tavily and Brave",
  "type": "module",
  "main": "./index.mjs",
  "license": "MIT",
  "author": "QUERIT PRIVATE LIMITED",
  "homepage": "https://www.querit.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/querit-ai/querit-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/querit-ai/querit-plugins/issues"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "querit",
    "web-search",
    "search"
  ],
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "magpie": {
    "name": "Querit",
    "icon": "https://www.querit.ai/images/logo.svg",
    "options": {
      "timeRange": "",
      "vertical": "",
      "highlights": false
    }
  },
  "scripts": {
    "check": "node --check index.mjs && node --check src/querit.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
